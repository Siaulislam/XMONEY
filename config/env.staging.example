# XMONEY Staging Environment (cPanel / smartdms.me)
# Copy to backend-api/.env AFTER deploy for E2E testing only.
# Use APP_ENV=production and APP_DEBUG=false before production go-live.
#
# Dev test user (OTP bypass active while APP_ENV is not production):
#   Email: ziassp91@gmai.com
#   Password: 123456

APP_NAME=XMONEY
APP_ENV=staging
APP_DEBUG=true
APP_URL=https://smartdms.me/api
APP_TIMEZONE=Asia/Dubai

DB_HOST=localhost
DB_PORT=3306
DB_NAME=smartdms_XMONEY
DB_USER=smartdms_xmoney
DB_PASS=CHANGE_ME
DB_CHARSET=utf8mb4

JWT_SECRET=CHANGE_ME_MIN_32_RANDOM_BYTES
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30
JWT_ISSUER=xmoney-api
JWT_AUDIENCE=xmoney-clients

BCRYPT_COST=12
CORS_ALLOWED_ORIGINS=https://smartdms.me,https://siaulislam.github.io
RATE_LIMIT_PER_MINUTE=60
SECURITY_MAX_LOGIN_ATTEMPTS=5
SECURITY_LOCKOUT_MINUTES=30
OTP_EXPIRY_MINUTES=10

UPLOAD_MAX_MB=10
UPLOAD_PATH=../storage/uploads

EXCHANGE_PROVIDER=manual
PAYMENT_DEFAULT_PROVIDER=stub

MAIL_DRIVER=smtp
SMTP_HOST=mail.smartdms.me
SMTP_PORT=465
SMTP_SECURE=ssl
SMTP_USER=xmoney@smartdms.me
SMTP_PASS=SET_ON_SERVER_ONLY
MAIL_FROM_ADDRESS=xmoney@smartdms.me
MAIL_FROM_NAME=XMONEY
SMS_DRIVER=log
PUSH_DRIVER=log

LOG_PATH=../storage/logs
LOG_LEVEL=debug
