# XMONEY Staging Environment (cPanel / qamar.tasjeel.ae)
# Copy to backend-api/.env AFTER deploy for E2E testing only.
# Use APP_DEBUG=false before production go-live.

APP_NAME=XMONEY
APP_ENV=staging
APP_DEBUG=true
APP_URL=https://qamar.tasjeel.ae/xmoney/api
APP_TIMEZONE=Asia/Dubai

DB_HOST=localhost
DB_PORT=3306
DB_NAME=smartdms_XMONEY
DB_USER=smartdms_xmoney
DB_PASS=CHANGE_ME
DB_CHARSET=utf8mb4

JWT_SECRET=CHANGE_ME_MIN_32_RANDOM_BYTES
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30
JWT_ISSUER=xmoney-api
JWT_AUDIENCE=xmoney-clients

BCRYPT_COST=12
CORS_ALLOWED_ORIGINS=https://qamar.tasjeel.ae
RATE_LIMIT_PER_MINUTE=60
SECURITY_MAX_LOGIN_ATTEMPTS=5
SECURITY_LOCKOUT_MINUTES=30
OTP_EXPIRY_MINUTES=10

UPLOAD_MAX_MB=10
UPLOAD_PATH=../storage/uploads

EXCHANGE_PROVIDER=manual
PAYMENT_DEFAULT_PROVIDER=stub

MAIL_DRIVER=log
MAIL_FROM_ADDRESS=noreply@xmoney.local
MAIL_FROM_NAME=XMONEY
SMS_DRIVER=log
PUSH_DRIVER=log

LOG_PATH=../storage/logs
LOG_LEVEL=debug
