# XMONEY Production Environment Template (cPanel)
# Copy to: public_html/xmoney/api/.env
# NEVER commit the real .env file.
#
# ISOLATION: Use ONLY the XMONEY database and XMONEY DB user.
# Do not point these values at your existing application database.

APP_NAME=XMONEY
APP_ENV=production
APP_DEBUG=false
APP_URL=https://qamar.tasjeel.ae/xmoney/api
APP_TIMEZONE=Asia/Dubai

# --- XMONEY database only (cPanel MySQL) ---
# Production names on this hosting:
#   DB_NAME=smartdms_XMONEY
#   DB_USER=smartdms_xmoney
DB_HOST=localhost
DB_PORT=3306
DB_NAME=smartdms_XMONEY
DB_USER=smartdms_xmoney
DB_PASS=
DB_CHARSET=utf8mb4

# --- Security (generate unique values for production) ---
JWT_SECRET=
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30
JWT_ISSUER=xmoney-api
JWT_AUDIENCE=xmoney-clients

BCRYPT_COST=12
# Comma-separated origins for customer web + admin (same host paths OK)
CORS_ALLOWED_ORIGINS=https://qamar.tasjeel.ae
RATE_LIMIT_PER_MINUTE=60
SECURITY_MAX_LOGIN_ATTEMPTS=5
SECURITY_LOCKOUT_MINUTES=30
OTP_EXPIRY_MINUTES=10

# Paths relative to api/ on cPanel package layout
UPLOAD_MAX_MB=10
UPLOAD_PATH=../storage/uploads

EXCHANGE_PROVIDER=manual
EXCHANGE_API_URL=
EXCHANGE_API_KEY=

PAYMENT_DEFAULT_PROVIDER=stub

MAIL_DRIVER=log
MAIL_FROM_ADDRESS=noreply@qamar.tasjeel.ae
MAIL_FROM_NAME=XMONEY
SMS_DRIVER=log
PUSH_DRIVER=log

LOG_PATH=../storage/logs
LOG_LEVEL=info
