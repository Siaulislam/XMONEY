# XMONEY Local Environment Template
# Copy to backend-api/.env for local development only.
# Do NOT use production cPanel credentials in this file.

APP_NAME=XMONEY
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_TIMEZONE=Asia/Dubai

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=xmoney
DB_USER=xmoney_user
DB_PASS=
DB_CHARSET=utf8mb4

JWT_SECRET=local_dev_only_change_me_to_random_32chars_min
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30
JWT_ISSUER=xmoney-api
JWT_AUDIENCE=xmoney-clients

BCRYPT_COST=12
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:5500
RATE_LIMIT_PER_MINUTE=120

UPLOAD_MAX_MB=10
UPLOAD_PATH=../uploads

EXCHANGE_PROVIDER=manual
EXCHANGE_API_URL=
EXCHANGE_API_KEY=

PAYMENT_DEFAULT_PROVIDER=stub

MAIL_DRIVER=log
MAIL_FROM_ADDRESS=noreply@xmoney.local
MAIL_FROM_NAME=XMONEY
SMS_DRIVER=log
PUSH_DRIVER=log

LOG_PATH=../logs
LOG_LEVEL=debug
