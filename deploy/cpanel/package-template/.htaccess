# ============================================================
# XMONEY root .htaccess
# Deployed to: /home/smartdms/public_html/
# Public URL:  https://qamar.tasjeel.ae/
# Applies at the hosting root for XMONEY.
# ============================================================

Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Force HTTPS (uncomment when SSL is active)
  # RewriteCond %{HTTPS} off
  # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Route /api/* to API front controller
  RewriteRule ^api/(.*)$ api/public/index.php [QSA,L]
</IfModule>

# Protect .env anywhere under this app folder
<FilesMatch "^\.env">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
</FilesMatch>
