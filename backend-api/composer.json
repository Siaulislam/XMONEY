{
  "name": "xmoney/backend-api",
  "description": "XMONEY Money Transfer Platform — Secure Backend API",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": ">=8.1",
    "ext-json": "*",
    "ext-pdo": "*",
    "ext-mbstring": "*",
    "ext-openssl": "*",
    "firebase/php-jwt": "^7.0",
    "vlucas/phpdotenv": "^5.6",
    "monolog/monolog": "^3.5",
    "ramsey/uuid": "^4.7"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5"
  },
  "autoload": {
    "psr-4": {
      "XMoney\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "XMoney\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "serve": "php -S localhost:8080 -t public public/router.php",
    "hash-password": "php scripts/hash-password.php"
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true
  }
}
