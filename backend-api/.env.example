# XMONEY Environment Template
# Copy to backend-api/.env (local) or public_html/xmoney/api/.env (cPanel).
# Do NOT commit real credentials.
#
# Production template with cPanel notes: ../config/env.production.example
# Isolation rules: ../documentation/ISOLATION.md

APP_NAME=XMONEY
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_TIMEZONE=Asia/Dubai

# Database — LOCAL example names only.
# On cPanel use the NEW XMONEY database/user only, e.g.:
#   DB_NAME={cpanel_user}_xmoney_db
#   DB_USER={cpanel_user}_xmoney_user
# Never point this at your existing application database.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=xmoney
DB_USER=xmoney_user
DB_PASS=
DB_CHARSET=utf8mb4

# JWT (generate strong secrets for production)
JWT_SECRET=change_this_to_a_long_random_secret_key_64chars_minimum_xxxxxxxxxxxx
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30
JWT_ISSUER=xmoney-api
JWT_AUDIENCE=xmoney-clients

# Security
BCRYPT_COST=12
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:5500
RATE_LIMIT_PER_MINUTE=60
SECURITY_MAX_LOGIN_ATTEMPTS=5
SECURITY_LOCKOUT_MINUTES=30
OTP_EXPIRY_MINUTES=10

# File uploads
UPLOAD_MAX_MB=10
UPLOAD_PATH=../uploads

# Exchange rate provider: manual (DB) or external (live API)
EXCHANGE_PROVIDER=manual
# Example live FX (no API key): https://api.frankfurter.app/latest
EXCHANGE_API_URL=
EXCHANGE_API_KEY=
EXCHANGE_DEFAULT_MARGIN=0.15

# Payment providers — select via PAYMENT_DEFAULT_PROVIDER (no hard-coded gateway)
PAYMENT_DEFAULT_PROVIDER=stub

# Stripe (future)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# Checkout.com (future)
# CHECKOUT_SECRET_KEY=
# CHECKOUT_WEBHOOK_SECRET=

# Wise (future)
# WISE_API_TOKEN=
# WISE_PROFILE_ID=

# UAE Bank API (future)
# UAE_BANK_API_URL=
# UAE_BANK_CLIENT_ID=
# UAE_BANK_CLIENT_SECRET=

# Notifications
MAIL_DRIVER=log
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=tls
SMTP_USER=
SMTP_PASS=
MAIL_FROM_ADDRESS=noreply@xmoney.local
MAIL_FROM_NAME=XMONEY
SMS_DRIVER=log
# Twilio (future)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
# AWS SNS (future)
# AWS_SNS_REGION=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# UAE SMS Gateway (future)
# UAE_SMS_API_URL=
# UAE_SMS_API_KEY=
# UAE_SMS_SENDER_ID=
PUSH_DRIVER=log
# PUSH_FCM_SERVER_KEY=

# Logging
LOG_PATH=../logs
LOG_LEVEL=debug
