# DEVELOPMENT ONLY - REMOVE BEFORE PRODUCTION
# Copy these lines into api/.env when you need temporary dev login (never in production).
#
# DEV_AUTH_BYPASS_ENABLED=true
# APP_ENV=staging
# APP_DEBUG=true
# DEV_TEST_EMAIL=your-dev-email@example.com
# DEV_TEST_PASSWORD=your-dev-password
#
# While bypass is OFF, set only DEV_TEST_EMAIL (no password) to auto-suspend that account.
